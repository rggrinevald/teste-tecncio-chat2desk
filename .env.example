# ==============================================
# MiniCRM - Variáveis de Ambiente
# Copie este arquivo para .env e preencha os valores
# ==============================================

# --- PostgreSQL ---
POSTGRES_DB=minicrm
POSTGRES_USER=minicrm_user
POSTGRES_PASSWORD=minicrm_password

# --- pgAdmin ---
PGADMIN_EMAIL=admin@minicrm.local
PGADMIN_PASSWORD=admin

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- Auth Service ---
# URL de conexão com o banco (usada pelo Prisma dentro do container)
DATABASE_URL=postgresql://minicrm_user:minicrm_password@postgres:5432/minicrm
# Chave secreta para assinar os JWTs — deve ter pelo menos 32 caracteres
JWT_SECRET=sua_chave_secreta_super_segura_minimo_32_chars
# Tempo de expiração do access token
JWT_EXPIRES_IN=15m
# TTL do refresh token em segundos (7 dias = 604800)
REFRESH_TOKEN_TTL=604800

# --- n8n ---
N8N_BASIC_AUTH_USER=admin
N8N_BASIC_AUTH_PASSWORD=admin_password
# Chave de criptografia do n8n para credenciais salvas
N8N_ENCRYPTION_KEY=n8n_encryption_key_change_me_32chars

# --- Cloudflare (para CI/CD e deploy manual) ---
# Token da API da Cloudflare com permissão de Workers e Pages
CF_API_TOKEN=
# ID da sua conta na Cloudflare
CF_ACCOUNT_ID=
# URL do Worker deployado (preenchida após o deploy)
WORKER_URL=https://minicrm-gateway.seu-usuario.workers.dev

# --- Cloudflare Tunnel (para expor o backend local com URL pública) ---
# Necessário para o Worker deployado conseguir acessar auth-service e n8n locais
# Crie em: https://one.dash.cloudflare.com → Networks → Tunnels → Create tunnel
# Cole o token do tunnel aqui:
CLOUDFLARE_TUNNEL_TOKEN=
# URLs públicas geradas pelo tunnel (preencha após criar o tunnel):
N8N_WEBHOOK_URL=https://n8n.seu-dominio.com

# --- Frontend (Vite) ---
# URL do API Gateway (Worker) — usada no build do frontend
VITE_API_URL=https://minicrm-gateway.seu-usuario.workers.dev
