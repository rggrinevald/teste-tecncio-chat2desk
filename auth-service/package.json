{
  "name": "auth-service",
  "version": "1.0.0",
  "description": "MiniCRM Auth Service",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsup src/index.ts --format cjs --dts --out-dir dist",
    "start": "node dist/index.js",
