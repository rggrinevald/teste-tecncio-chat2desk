{
  "name": "List Contacts",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "GET",
        "path": "contacts",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-list",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "list-contacts"
    },
    {
      "parameters": {
        "operation": "get",
        "key": "={{ 'contacts:' + $json.headers['x-user-id'] }}"
      },
      "id": "redis-get",
      "name": "Get Cache",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [460, 300],
      "credentials": {
        "redis": {
          "id": "2",
          "name": "MiniCRM Redis"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.value }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "if-cache",
      "name": "Cache Hit?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "jsCode": "const contacts = JSON.parse($json.value);\nreturn [{ json: { contacts } }];"
      },
      "id": "parse-cache",
      "name": "Parse Cache",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [900, 180]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $json.contacts }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-cache",
      "name": "Respond 200 (Cache)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1120, 180]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT * FROM \"Contact\" WHERE \"userId\" = '{{ $node[\"Webhook\"].json.headers[\"x-user-id\"] }}' AND ('{{ $node[\"Webhook\"].json.headers[\"x-include-deleted\"] }}' = 'true' OR \"deletedAt\" IS NULL) ORDER BY \"createdAt\" DESC",
        "additionalFields": {}
      },
      "id": "postgres-select",
      "name": "Fetch Contacts",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [900, 420],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "MiniCRM Postgres"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst contacts = items.map(item => item.json);\nreturn [{ json: { contacts } }];"
      },
      "id": "aggregate-results",
      "name": "Aggregate Array",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1120, 420]
    },
    {
      "parameters": {
        "operation": "set",
        "key": "={{ 'contacts:' + $node['Webhook'].json.headers['x-user-id'] }}",
        "value": "={{ JSON.stringify($json.contacts) }}",
        "expire": true,
        "ttl": 300
      },
      "id": "redis-set",
      "name": "Set Cache",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [1340, 420],
      "credentials": {
        "redis": {
          "id": "2",
          "name": "MiniCRM Redis"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $node['Aggregate Array'].json.contacts }}",
        "options": {
          "responseCode": 200
        }
      },
      "id": "respond-db",
      "name": "Respond 200 (DB)",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1560, 420]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Get Cache", "type": "main", "index": 0 }]]
    },
    "Get Cache": {
      "main": [[{ "node": "Cache Hit?", "type": "main", "index": 0 }]]
    },
    "Cache Hit?": {
      "main": [
        [{ "node": "Parse Cache", "type": "main", "index": 0 }],
        [{ "node": "Fetch Contacts", "type": "main", "index": 0 }]
      ]
    },
    "Parse Cache": {
      "main": [[{ "node": "Respond 200 (Cache)", "type": "main", "index": 0 }]]
    },
    "Fetch Contacts": {
      "main": [[{ "node": "Aggregate Array", "type": "main", "index": 0 }]]
    },
    "Aggregate Array": {
      "main": [[{ "node": "Set Cache", "type": "main", "index": 0 }]]
    },
    "Set Cache": {
      "main": [[{ "node": "Respond 200 (DB)", "type": "main", "index": 0 }]]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
