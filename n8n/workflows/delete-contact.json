{
  "name": "Delete Contact",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "DELETE",
        "path": "contacts-delete",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-delete",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "delete-contact"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT id FROM \"Contact\" WHERE id = '{{ $node[\"Webhook\"].json.headers[\"x-contact-id\"] }}' AND \"userId\" = '{{ $node[\"Webhook\"].json.headers[\"x-user-id\"] }}'",
        "additionalFields": {}
      },
      "id": "postgres-check",
      "name": "Check Ownership",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [460, 300],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "MiniCRM Postgres"
        }
      }
    },
    {
      "parameters": {
        "conditions": {
          "number": [
            {
              "value1": "={{ $items().length }}",
              "operation": "larger",
              "value2": 0
            }
          ]
        }
      },
      "id": "if-exists",
      "name": "Contact Exists?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [680, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "UPDATE \"Contact\" SET \"deletedAt\" = NOW(), \"updatedAt\" = NOW() WHERE id = '{{ $node[\"Webhook\"].json.headers[\"x-contact-id\"] }}' AND \"userId\" = '{{ $node[\"Webhook\"].json.headers[\"x-user-id\"] }}'",
        "additionalFields": {}
      },
      "id": "postgres-delete",
      "name": "Soft Delete Contact",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [900, 180],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "MiniCRM Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "delete",
        "key": "={{ 'contacts:' + $node['Webhook'].json.headers['x-user-id'] }}"
      },
      "id": "redis-invalidate-delete",
      "name": "Invalidate Cache",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [1120, 180],
      "credentials": {
        "redis": {
          "id": "2",
          "name": "MiniCRM Redis"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "noData",
        "options": {
          "responseCode": 204
        }
      },
      "id": "respond-204",
      "name": "Respond 204",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1340, 180]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"error\": \"Contato não encontrado\" }",
        "options": {
          "responseCode": 404
        }
      },
      "id": "respond-404",
      "name": "Respond 404",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [900, 420]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Check Ownership", "type": "main", "index": 0 }]]
    },
    "Check Ownership": {
      "main": [[{ "node": "Contact Exists?", "type": "main", "index": 0 }]]
    },
    "Contact Exists?": {
      "main": [
        [{ "node": "Soft Delete Contact", "type": "main", "index": 0 }],
        [{ "node": "Respond 404", "type": "main", "index": 0 }]
      ]
    },
    "Soft Delete Contact": {
      "main": [[{ "node": "Invalidate Cache", "type": "main", "index": 0 }]]
    },
    "Invalidate Cache": {
      "main": [[{ "node": "Respond 204", "type": "main", "index": 0 }]]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
