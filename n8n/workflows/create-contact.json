{
  "name": "Create Contact",
  "nodes": [
    {
      "parameters": {
        "httpMethod": "POST",
        "path": "contacts",
        "responseMode": "responseNode",
        "options": {}
      },
      "id": "webhook-create",
      "name": "Webhook",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 1,
      "position": [240, 300],
      "webhookId": "create-contact"
    },
    {
      "parameters": {
        "conditions": {
          "string": [
            {
              "value1": "={{ $json.body.name }}",
              "operation": "isNotEmpty"
            }
          ]
        }
      },
      "id": "if-validate",
      "name": "Validate Fields",
      "type": "n8n-nodes-base.if",
      "typeVersion": 1,
      "position": [460, 300]
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO \"Contact\" (id, name, email, phone, \"userId\", \"createdAt\", \"updatedAt\") VALUES (gen_random_uuid(), '{{ $json.body.name }}', NULLIF('{{ $json.body.email }}', ''), NULLIF('{{ $json.body.phone }}', ''), '{{ $json.headers[\"x-user-id\"] }}', NOW(), NOW()) RETURNING *",
        "additionalFields": {}
      },
      "id": "postgres-insert",
      "name": "Insert Contact",
      "type": "n8n-nodes-base.postgres",
      "typeVersion": 2,
      "position": [680, 180],
      "credentials": {
        "postgres": {
          "id": "1",
          "name": "MiniCRM Postgres"
        }
      }
    },
    {
      "parameters": {
        "operation": "delete",
        "key": "={{ 'contacts:' + $node['Webhook'].json.headers['x-user-id'] }}"
      },
      "id": "redis-invalidate-create",
      "name": "Invalidate Cache",
      "type": "n8n-nodes-base.redis",
      "typeVersion": 1,
      "position": [900, 180],
      "credentials": {
        "redis": {
          "id": "2",
          "name": "MiniCRM Redis"
        }
      }
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={{ $node['Insert Contact'].json }}",
        "options": {
          "responseCode": 201
        }
      },
      "id": "respond-success",
      "name": "Respond 201",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [1120, 180]
    },
    {
      "parameters": {
        "respondWith": "json",
        "responseBody": "={ \"error\": \"O campo name é obrigatório\" }",
        "options": {
          "responseCode": 400
        }
      },
      "id": "respond-error",
      "name": "Respond 400",
      "type": "n8n-nodes-base.respondToWebhook",
      "typeVersion": 1,
      "position": [680, 420]
    }
  ],
  "connections": {
    "Webhook": {
      "main": [[{ "node": "Validate Fields", "type": "main", "index": 0 }]]
    },
    "Validate Fields": {
      "main": [
        [{ "node": "Insert Contact", "type": "main", "index": 0 }],
        [{ "node": "Respond 400", "type": "main", "index": 0 }]
      ]
    },
    "Insert Contact": {
      "main": [[{ "node": "Invalidate Cache", "type": "main", "index": 0 }]]
    },
    "Invalidate Cache": {
      "main": [[{ "node": "Respond 201", "type": "main", "index": 0 }]]
    }
  },
  "active": true,
  "settings": {
    "executionOrder": "v1"
  }
}
